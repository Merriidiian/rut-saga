{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "lab-saga"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "eventstore-data",
        "namespace": "lab-saga"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "eventstore",
        "namespace": "lab-saga"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "eventstore"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "eventstore"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "eventstore",
                "image": "eventstore/eventstore:23.10.0-bookworm-slim",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 2113
                  }
                ],
                "env": [
                  {
                    "name": "EVENTSTORE_CLUSTER_SIZE",
                    "value": "1"
                  },
                  {
                    "name": "EVENTSTORE_ENABLE_ATOM_PUB_OVER_HTTP",
                    "value": "true"
                  },
                  {
                    "name": "EVENTSTORE_INSECURE",
                    "value": "true"
                  },
                  {
                    "name": "EVENTSTORE_RUN_PROJECTIONS",
                    "value": "All"
                  },
                  {
                    "name": "EVENTSTORE_START_STANDARD_PROJECTIONS",
                    "value": "true"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 2113
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/eventstore"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "eventstore-data"
                }
              }
            ],
            "securityContext": {
              "fsGroup": 1000
            },
            "enableServiceLinks": false
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "eventstore",
        "namespace": "lab-saga"
      },
      "spec": {
        "selector": {
          "app": "eventstore"
        },
        "ports": [
          {
            "name": "port-2113",
            "port": 2113,
            "targetPort": 2113
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "gateway-config",
        "namespace": "lab-saga"
      },
      "data": {
        "nginx.conf": "events {}\nhttp {\n  server {\n    listen 8080;\n    location /api/v1/reservations { proxy_pass http://reservation:8081; }\n    location /reservation-swagger/ { proxy_pass http://reservation:8081/swagger/; }\n    location / { proxy_pass http://warehouse:8080; }\n  }\n}\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "gateway",
        "namespace": "lab-saga"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "gateway"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "gateway"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "gateway",
                "image": "nginx:1.27-alpine",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8080
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/nginx/nginx.conf",
                    "subPath": "nginx.conf",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "gateway-config"
                }
              }
            ],
            "enableServiceLinks": false
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "gateway",
        "namespace": "lab-saga"
      },
      "spec": {
        "selector": {
          "app": "gateway"
        },
        "ports": [
          {
            "name": "port-8080",
            "port": 8080,
            "targetPort": 8080,
            "nodePort": 30802
          }
        ],
        "type": "NodePort"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "reservation",
        "namespace": "lab-saga"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "reservation"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "reservation"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "reservation",
                "image": "lab-saga-reservation:local",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 50051
                  },
                  {
                    "containerPort": 8081
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 50051
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                }
              }
            ],
            "enableServiceLinks": false
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "reservation",
        "namespace": "lab-saga"
      },
      "spec": {
        "selector": {
          "app": "reservation"
        },
        "ports": [
          {
            "name": "port-50051",
            "port": 50051,
            "targetPort": 50051
          },
          {
            "name": "port-8081",
            "port": 8081,
            "targetPort": 8081
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "warehouse",
        "namespace": "lab-saga"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "warehouse"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "warehouse"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "warehouse",
                "image": "lab-saga-warehouse:local",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "env": [
                  {
                    "name": "ConnectionStrings__EventStore",
                    "value": "esdb://eventstore:2113?tls=false"
                  },
                  {
                    "name": "ReservationUrl",
                    "value": "http://reservation:50051"
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8080
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3
                }
              }
            ],
            "enableServiceLinks": false
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "warehouse",
        "namespace": "lab-saga"
      },
      "spec": {
        "selector": {
          "app": "warehouse"
        },
        "ports": [
          {
            "name": "port-8080",
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    }
  ]
}